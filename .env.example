# MongoDB (store real values in a local .env only; never commit secrets)
MONGODB_URI="mongodb://username:password@localhost:27017/cronjob-dev"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="CronJob.io"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Scheduler (runs on Render as a free-tier WEB SERVICE, NOT on Vercel, and NOT
# as a paid Background Worker). Render sets RENDER=true, which auto-enables the
# in-process HTTP server on 0.0.0.0:$PORT with GET /health and GET /wake.
# An external cron (e.g. EasyCron) calls /health every ~10 minutes to wake/keep
# the free Web Service alive. That request NEVER executes jobs; it only wakes
# the process, and the scheduler loop then polls MongoDB for what is due.
SCHEDULER_POLL_INTERVAL_MS=10000
SCHEDULER_HEARTBEAT_INTERVAL_MS=30000
SCHEDULER_MAX_CONCURRENT_JOBS=5
SCHEDULER_LOCK_EXPIRY_MS=900000
SCHEDULER_MAX_CATCHUP_JOBS=50
SCHEDULER_INSTANCE_ID="local-dev"
SCHEDULER_API_TOKEN="replace-with-a-long-random-secret-for-scheduler-api-access"

# Health/wake HTTP server. ON locally only if this is true (on Render it is
# auto-enabled via RENDER=true). `PORT` is auto-provided by Render; locally it
# is 3100 so it never collides with the Next.js dev server on 3000.
SCHEDULER_HEALTH_ENABLED=false
PORT=3100

# Vercel wake relay for the free Render Web Service.
# EasyCron (free) cannot target *.onrender.com directly, so EasyCron calls
#   GET /api/wake-render  (Authorization: Bearer <RENDER_WAKE_TOKEN>)
# every ~10 minutes. This Vercel endpoint performs a fixed server-side fetch to
# RENDER_WAKE_URL (only https *.onrender.com/health is accepted) which causes
# the inbound traffic that wakes/keeps alive the Render Web Service. It never
# executes cron jobs. Keep RENDER_WAKE_TOKEN private; never hardcode it.
RENDER_WAKE_URL="https://cron-8vgj.onrender.com/health"
RENDER_WAKE_TOKEN="replace-with-a-long-random-secret"

# Security (optional - falls back to NEXTAUTH_SECRET if not set)
CSRF_SECRET="replace-with-a-long-random-secret"
HEADER_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Cron scheduling limits (ms)
CRON_MIN_INTERVAL_MS=60000

# Outbound HTTP (shared by scheduler worker and manual Run Now)
TRUSTED_PROXY=true
DEBUG=false

# AI Dev Assistant (optional - the whole feature degrades gracefully without
# these). GROQ_API_KEY enables error analysis, follow-up chat and the
# "Generate API" wizard. It is server-side only and never sent to the browser.
# Get a key from https://console.groq.com/keys (starts with gsk_).
GROQ_API_KEY=""
# Model used for technical reasoning (error analysis, fixes, API generation).
# Defaults to openai/gpt-oss-120b.
GROQ_REASONING_MODEL="openai/gpt-oss-120b"
# Model used for web-research briefs when a problem may depend on current docs.
# Defaults to groq/compound-mini. GROQ_MODEL is also honored as a fallback for both.
GROQ_RESEARCH_MODEL="groq/compound-mini"
# Set to "false" to keep capturing issues but never auto-analyze them with the AI.
AI_ANALYSIS_ENABLED="true"
# Server-side dedup tuning (safe defaults apply when unset). The same error
# fingerprint is not re-analyzed for this long, and a previous web-research
# brief for the same question is reused for this long. Manual "Analyze"/retry
# always bypasses the cooldown.
AI_ANALYSIS_COOLDOWN_MS=3600000
AI_RESEARCH_CACHE_MS=3600000

# Temporary Email (Disposable Email)
# ------------------------------------------------------------------
# The Temp Mail feature lets authenticated users receive emails on a
# disposable address at the TEMP_MAIL_DOMAIN subdomain. See
# docs/TEMP-MAIL-SETUP.md for full DNS/provider configuration.
#
# Inbound provider name. Leave empty/default to disable receiving
# (the UI will show "not configured" and no emails will be faked).
TEMP_MAIL_PROVIDER=""
# Public domain used for temporary addresses (must point via DNS/MX to the
# inbound provider). Do NOT point cronjobs.site here.
TEMP_MAIL_DOMAIN="temp.cronjobs.site"
# Provider secret/API key. Server-side only. NEVER use NEXT_PUBLIC_, never
# commit a real value.
TEMP_MAIL_API_KEY=""
# Shared secret used to verify provider webhook signatures on
# POST /api/temp-mail/webhook. Server-side only.
TEMP_MAIL_WEBHOOK_SECRET=""
# How long a temporary mailbox lives before it expires/deletes.
TEMP_MAIL_EXPIRATION_MINUTES=30